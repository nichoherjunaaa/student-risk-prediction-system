# Copy to .env on the VPS and adjust. Do NOT commit .env.

# Host port the app is published on (change if 80 is free, or to fit a proxy).
SISIP_HTTP_PORT=8090

# Seeded only on first run, when the users table is empty.
SISIP_ADMIN_EMAIL=admin@gmail.com
SISIP_ADMIN_PASSWORD=change-me-strong-password
