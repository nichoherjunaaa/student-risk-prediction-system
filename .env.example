# Copy to .env on the VPS and adjust. Do NOT commit .env.

# Host port the app is published on (change if 80 is free, or to fit a proxy).
SISIP_HTTP_PORT=8090

# Seeded only on first run, when the users table is empty.
SISIP_ADMIN_EMAIL=admin@gmail.com
SISIP_ADMIN_PASSWORD=change-me-strong-password

# WAJIB di produksi: kunci penandatangan token login. Tanpa ini token bisa
# dipalsukan siapa saja. Buat acak, mis: python -c "import secrets;print(secrets.token_urlsafe(48))"
SISIP_SECRET_KEY=change-me-random-long-string

# Masa berlaku token login dalam detik (default 12 jam).
SISIP_TOKEN_MAX_AGE=43200

# Batasi origin CORS di produksi, mis: https://sisip.kampus.ac.id (koma untuk banyak).
# Biarkan * hanya untuk pengembangan lokal.
SISIP_CORS_ORIGINS=*

# Demo accounts (one per role) for E2E testing. Idempotent on every startup.
# Set to 0 for a real production deploy.
SISIP_SEED_DEMO_USERS=1
